{
  "name": "Veill",
  "expo": {
    "name": "Veill",
    "slug": "veill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/veill.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/veill.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stargazer.veill",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "veill.qzz.io": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTP": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "preetllm.qzz.io": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTP": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        },
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/veill.png",
        "backgroundColor": "#000000"
      },
      "package": "com.stargazer.veill",
      "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/veill.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
