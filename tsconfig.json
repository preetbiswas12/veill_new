{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "types.d.ts"
  ],
  "exclude": [
    "veill_relay",
    "node_modules",
    "**/node_modules",
    "**/node_modules/**/src/**/*",
    "android",
    "ios"
  ]
}
