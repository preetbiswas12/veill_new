shamefully-hoist=true

# pnpm's default isolated layout nests packages as
#   node_modules/.pnpm/<pkg>@<64-char-hash>/node_modules/<pkg>
# which pushes CMake/Ninja object paths for react-native-worklets and friends
# past Windows' 250-character limit, failing the native build with
# "manifest 'build.ninja' still dirty after 100 tries".
# The hoisted (npm-style) layout keeps those same object paths at ~127 chars.
node-linker=hoisted