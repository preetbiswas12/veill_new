# Veill mobile environment variables
# Copy to .env and fill in real values from your service dashboards.

# ─── CometChat (https://app.cometchat.com) ──────────────────────────────
# Must match backend/.env. Auth key never goes in the mobile app.
COMETCHAT_APP_ID=16821203e71872c8c
COMETCHAT_REGION=IN

# ─── Backend API ───────────────────────────────────────────────────────
# Local dev:                http://localhost:3000
# Render (after deploy):    https://veill-backend.onrender.com
API_BASE_URL=http://localhost:3000
PUSH_SERVER_URL=http://localhost:3000

# ─── OneSignal (https://app.onesignal.com) ─────────────────────────────
# Must match backend/.env. Get from Settings → Keys & IDs.
# Without this, push is disabled (calls only ring on the caller's own device).
ONESIGNAL_APP_ID=

# ─── Daily.co (https://dashboard.daily.co) ─────────────────────────────
# Domain only — server uses DAILY_API_KEY from backend/.env.
DAILY_DOMAIN=veill.daily.co
