# Copy to .env and fill in. Never commit the filled-in version.

# --- CometChat (from Dashboard → App → API Keys) ---
COMETCHAT_APP_ID=
COMETCHAT_AUTH_KEY=
COMETCHAT_REGION=us

# --- Server ---
PORT=8080

# --- FCM (Android) ---
# Service-account JSON from Firebase Console → Project settings → Service accounts.
# Either inline JSON…
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", …}
# …or a path to the downloaded file:
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# --- APNs (iOS) ---
# From Apple Developer → Keys → AuthKey_XXXXXXXXXX.p8
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
# 'sandbox' for a debug build, 'production' for TestFlight/App Store.
APNS_ENVIRONMENT=sandbox

# --- Shared secret used to authenticate app → server requests ---
# Generate with: openssl rand -hex 32
CLIENT_SHARED_SECRET=
